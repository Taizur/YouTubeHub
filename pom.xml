
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.youtubehub</groupId>
    <artifactId>youtubehub</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- YouTube Data API -->
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-youtube</artifactId>
            <version>v3-rev20261019-2.9.2</version>
        </dependency>

        <!-- JSON processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.4</version>
        </dependency>

        <!-- SQLite database -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.0</version>
        </dependency>

        <!-- JavaFX (desktop UI). 21.x matches the project's Java 21 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.13</version>
        </dependency>

    </dependencies>

    <build>
        <!-- The jar is called target/YouTubeHub.jar -->
        <finalName>YouTubeHub</finalName>
        <plugins>
            <!-- "mvn package" builds ONE jar with the app and every library it needs inside it,
                 so it runs on its own with: javaw -jar YouTubeHub.jar
                 (Start it from the project folder: config.properties and youtubehub.db are read from there.) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Don't write dependency-reduced-pom.xml into the project (only useful when publishing libraries) -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Only the libraries the app really uses (the Google API library isn't used: plain HttpClient instead) -->
                            <artifactSet>
                                <includes>
                                    <include>com.youtubehub:youtubehub</include>
                                    <include>com.fasterxml.jackson.core:*</include>
                                    <include>org.xerial:sqlite-jdbc</include>
                                    <include>org.openjfx:*</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <!-- Signature files from other jars would make Java reject the combined jar -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- Launcher, not YouTubeHubApp: a jar's main class can't extend Application -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.youtubehub.Launcher</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Lets you start the app with: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.youtubehub.ui.YouTubeHubApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
